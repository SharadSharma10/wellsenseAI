# WellSense AI Environment Variables
PROJECT_NAME="WellSense AI - Student Mental Well-Being Screening Platform"
VERSION="1.0.0"
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (defaults to local SQLite if MONGODB_URI is not set)
DATABASE_PATH="wellsense.db"
# MONGODB_URI="mongodb://localhost:27017/wellsense"

# CORS Allowed Origins (comma separated or handled in config)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
